# 🔑 إعدادات بوت OSINT — انسخ هذا الملف باسم .env ثم ضع القيم الحقيقية
# ⚠️ لا ترفع ملف .env إلى GitHub أبداً (مستثنى تلقائياً في .gitignore)

# توكن البوت من @BotFather
BOT_TOKEN=ضع_التوكن_هنا

# (اختياري) معرّفات مشرفين إضافيين مفصولة بفواصل — المالك 8876599674 مضاف تلقائياً
ADMIN_IDS=

# (اختياري) مستوى السجلات: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
